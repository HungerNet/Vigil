// Vigil - embedded resources for Vigil.dll and the UI preview.
#include "../src/ui/resources.h"
#include "core/version.h"

VIGIL_RES_FONT_REGULAR  RCDATA "fonts/Inter-Regular.ttf"
VIGIL_RES_FONT_MEDIUM   RCDATA "fonts/Inter-Medium.ttf"
VIGIL_RES_FONT_SEMIBOLD RCDATA "fonts/Inter-SemiBold.ttf"
VIGIL_RES_FONT_DISPLAY  RCDATA "fonts/InterDisplay-SemiBold.ttf"

1 VERSIONINFO
FILEVERSION VIGIL_VERSION_MAJOR,VIGIL_VERSION_MINOR,VIGIL_VERSION_PATCH,0
PRODUCTVERSION VIGIL_VERSION_MAJOR,VIGIL_VERSION_MINOR,VIGIL_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x2L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Vigil"
      VALUE "FileDescription", "Vigil runtime - cheat detection and player analysis for Lunar Client"
      VALUE "FileVersion", VIGIL_VERSION_RC_STRING
      VALUE "InternalName", "Vigil"
      VALUE "OriginalFilename", "Vigil.dll"
      VALUE "ProductName", "Vigil"
      VALUE "ProductVersion", VIGIL_VERSION_RC_STRING
      VALUE "LegalCopyright", "Vigil. Inter typeface (c) The Inter Project Authors, SIL OFL 1.1."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
